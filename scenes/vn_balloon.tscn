[node name="HistoryHeader" type="HBoxContainer" parent="Balloon/UIRoot/HistoryPanel/HistoryMargin/HistoryVBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HistoryTitle" type="Label" parent="Balloon/UIRoot/HistoryPanel/HistoryMargin/HistoryVBox/HistoryHeader"]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.78, 0.42, 1)
theme_override_fonts/font = ExtResource("5_serifbold")
theme_override_font_sizes/font_size = 26
text = "History"

[node name="HistoryHint" type="Label" parent="Balloon/UIRoot/HistoryPanel/HistoryMargin/HistoryVBox/HistoryHeader"]
layout_mode = 2
size_flags_horizontal = 3
