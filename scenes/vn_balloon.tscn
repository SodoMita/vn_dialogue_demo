theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 90
theme_override_constants/margin_bottom = 60

[node name="PanicVBox" type="VBoxContainer" parent="Balloon/PanicScreen/PanicMargin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="PanicTitle" type="Label" parent="Balloon/PanicScreen/PanicMargin/PanicVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.1, 0.1, 0.1, 1)
theme_override_fonts/font = ExtResource("5_serifbold")
theme_override_font_sizes/font_size = 30
text = "PHYS 201 - Quantum Mechanics II"

[node name="PanicBody" type="Label" parent="Balloon/PanicScreen/PanicMargin/PanicVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.15, 0.15, 0.15, 1)
theme_override_fonts/font = ExtResource("4_serif")
theme_override_font_sizes/font_size = 18
autowrap_mode = 2
text = "Lecture 12: The time-independent Schroedinger equation. H psi = E psi, where H is the Hamiltonian operator. For a particle in a 1-D infinite well of width L the energy eigenvalues are E_n = n^2 h^2 / (8 m L^2). Reminder: problem set 4 is due Friday - problems 3.7, 3.9 and the derivation of the uncertainty principle for position and momentum."

