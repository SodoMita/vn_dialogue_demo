grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_history")

[node name="HistoryMargin" type="MarginContainer" parent="Balloon/UIRoot/HistoryPanel"]
layout_mode = 2
theme_override_constants/margin_left = 70
theme_override_constants/margin_top = 46
theme_override_constants/margin_right = 70
theme_override_constants/margin_bottom = 60

[node name="HistoryVBox" type="VBoxContainer" parent="Balloon/UIRoot/HistoryPanel/HistoryMargin"]
layout_mode = 2
