# --- Dialogue (context "dialogue", as looked up by the Dialogue Manager addon) ---

msgctxt "dialogue"
msgid "Rook"
msgstr "Рук"

msgctxt "dialogue"
msgid "Maya"
msgstr "Майя"

msgctxt "dialogue"
msgid "The afternoon light pools between the desks. Somewhere, a chalk tap-taps against the board."
msgstr "Послеполуденный свет скапливается между партами. Где-то мелок стучит по доске."

msgctxt "dialogue"
msgid "Another transfer student. Just what this school needed."
msgstr "Ещё один переводник. Только этого нашей школе не хватало."

msgctxt "dialogue"
msgid "H-hey! The bell hasn't even rung yet, I'm not late!"
msgstr "Э-эй! Звонок ещё даже не звенел, я не опоздала!"

msgctxt "dialogue"
msgid "The bell rang four minutes ago."
msgstr "Звонок прозвенел четыре минуты назад."

msgctxt "dialogue"
msgid "..."
msgstr "..."

msgctxt "dialogue"
msgid "Fine, you win, clock-watch person. I'm {{player_name}}. And you are?"
msgstr "Ладно, твоя взяла, человек-часы. Я — {{player_name}}. А ты?"

msgctxt "dialogue"
msgid "I'm Alex. Nice to meet you."
msgstr "Я Алекс. Приятно познакомиться."

msgctxt "dialogue"
msgid "{{player_name}}! That's a solid name. I'm Maya!"
msgstr "{{player_name}}! Хорошее имя. Я — Майя!"

msgctxt "dialogue"
msgid "I'd rather not say."
msgstr "Лучше не скажу."

msgctxt "dialogue"
msgid "Ooh, the mysterious type. I'm Maya. I'll find out eventually."
msgstr "О-о, загадочный тип. Я — Майя. Рано или поздно узнаю."

msgctxt "dialogue"
msgid "(Stay silent)"
msgstr "(Промолчать)"

msgctxt "dialogue"
msgid "...You're fun to tease. I'm Maya."
msgstr "...С тобой весело дразниться. Я — Майя."

msgctxt "dialogue"
msgid "Enjoy the rooftop if you like. Everyone ends up there eventually."
msgstr "Крыша в твоём распоряжении. Все там рано или поздно оказываются."

msgctxt "dialogue"
msgid "The first bell of the day finally rings, [color=#9fd8ff]sharp and bright[/color]."
msgstr "Наконец звенит первый звонок дня, [color=#9fd8ff]резкий и звонкий[/color]."

msgctxt "dialogue"
msgid "Another day at {{school_name}}. The halls already hum with gossip."
msgstr "Ещё один день в {{school_name}}. В коридорах уже гудят от сплетен."

msgctxt "dialogue"
msgid "Wind over the chain-link fence. The city glitters below like scattered coins."
msgstr "Ветер над сеткой забора. Внизу блестит город, как рассыпанные монеты."

msgctxt "dialogue"
msgid "See? Told you the view was worth the stairs."
msgstr "Видишь? Я же говорила, что вид стоит лестницы."

msgctxt "dialogue"
msgid "You brought a witness to my hiding spot. Unforgivable."
msgstr "Ты привела свидетеля в моё убежище. Непростительно."

msgctxt "dialogue"
msgid "Ask what Rook hides up here."
msgstr "Спросить, что Рук прячет здесь наверху."

msgctxt "dialogue"
msgid "Quiet. It's the only currency this school respects."
msgstr "Тише. Это единственная валюта, которую уважает эта школа."

msgctxt "dialogue"
msgid "Ask Maya why she's so kind."
msgstr "Спросить Майю, почему она такая добрая."

msgctxt "dialogue"
msgid "Kind? I just collect interesting people. You're exhibit A."
msgstr "Добрая? Я просто коллекционирую интересных людей. Ты — экспонат А."

msgctxt "dialogue"
msgid "(Say nothing. Watch the sunset.)"
msgstr "(Промолчать. Смотреть на закат.)"

msgctxt "dialogue"
msgid "The sun goes down slow, and for once, nobody says a word."
msgstr "Солнце садится медленно, и хоть раз никто не говорит ни слова."

msgctxt "dialogue"
msgid "Same time tomorrow?"
msgstr "Завтра в то же время?"

msgctxt "dialogue"
msgid "...Hmph. Don't be late."
msgstr "...Хмпф. Не опаздывай."

msgctxt "dialogue"
msgid "The three of you watch until the sky burns out."
msgstr "Вы втроём смотрите, пока небо не догорит."

